#=======================================================================
# Billions Store - environment configuration
#
# Copy to `.env` in the SAME directory as `index.php` and `app/` - this
# whole tree deploys as one unit, see README.md's "Layout" section for
# why - then:  chmod 600 .env
#
# This file must never be web-reachable. What keeps it that way is the
# root .htaccess's dotfile-deny rule, not its filesystem location. If you
# can load https://your-domain/.env in a browser, that rule has been
# lost or overridden - check the root .htaccess before putting real
# keys in this file.
#=======================================================================

#--- Environment -------------------------------------------------------
# production | development
# development turns on error display and relaxes the HTTPS-only cookie
# flag so you can work on http://localhost.
APP_ENV=production
APP_NAME="Billions Store"
APP_URL=https://example.com

# 32+ random bytes, base64. Used to sign email-verification and
# password-reset tokens and to derive the TOTP secret encryption key.
# Generate with:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

#--- Database ----------------------------------------------------------
# Hostinger gives you these in hPanel > Databases > Management.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_billions
DB_USER=u000000000_billions
DB_PASS=
DB_CHARSET=utf8mb4

#--- Money -------------------------------------------------------------
# The ledger is denominated in this fiat currency, stored as signed
# integer minor units (cents). Crypto is converted at deposit time; we
# never store a fractional balance.
LEDGER_CURRENCY=USD
LEDGER_CURRENCY_MINOR_DIGITS=2

# Minimum and maximum single top-up, in minor units. 25.00 - 25,000.00
TOPUP_MIN_MINOR=2500
TOPUP_MAX_MINOR=2500000

#--- Chain: Bitcoin Ordinals ------------------------------------------
# Ordinals are inscriptions on satoshis; there is no contract address.
# Receiving wallets must be taproot (bc1p...) or the inscription can be
# lost as a network fee by a wallet that does not track ordinals.
CHAIN=bitcoin-ordinals
BITCOIN_NETWORK=mainnet
# Comma-separated bech32 human-readable parts accepted for buyer
# addresses. mainnet = bc ; testnet/signet = tb ; regtest = bcrt
BITCOIN_ADDRESS_HRP=bc
# Require taproot (witness v1 / bc1p) for buyer payout addresses.
# Strongly recommended: leave at true.
REQUIRE_TAPROOT_PAYOUT=true

# Block explorers. %s is substituted.
EXPLORER_TX_URL=https://mempool.space/tx/%s
EXPLORER_ADDRESS_URL=https://mempool.space/address/%s
EXPLORER_INSCRIPTION_URL=https://ordinals.com/inscription/%s

#--- Deposits: manual BTC address --------------------------------------
# The live deposit path. One address you control, shown on the wallet
# page with a QR code. There is no per-user address and no webhook -
# a customer sends BTC here, and once it has confirmed on a block
# explorer, an admin credits their balance by hand from
# Admin > Users > (the customer) > Manual adjustment. That credit goes
# through the same ledger as every other credit (Wallet::credit()), so
# it shows on the customer's statement like any other line.
#
# Any Bitcoin address type is accepted here (legacy, segwit, taproot) -
# whatever your own wallet gives you as its receive address. This is
# different from a buyer's inscription payout address, which must be
# taproot; this address only ever receives plain BTC, never an
# inscription.
#
# Get this wrong and every customer deposit goes to the wrong place.
# php bin/doctor.php checks that this is at least a structurally valid
# Bitcoin address before you go live - it cannot check that it's YOUR
# address, only that it could be a real one.
MANUAL_BTC_ADDRESS=

#--- Account activation --------------------------------------------------
# The catalog is open to browse for everyone, signed in or not. What is
# gated is CHECKOUT: a new registration starts `pending` and becomes
# `active` automatically the instant a wallet credit brings its balance
# to this minimum - see App\AccountActivation. This is an ordinary,
# fully spendable deposit, credited through the same Wallet::credit()
# ledger path as any other deposit. It is never converted into a fee and
# never consumed by activation itself - only by whatever the customer
# then chooses to buy.
ACCOUNT_MIN_ACTIVATION_MINOR=5000
# false lets a pending account buy immediately - activation becomes
# informational only. Leave true unless you have a reason not to.
REQUIRE_ACTIVATION_TO_PURCHASE=true

#--- Billions Membership --------------------------------------------------
# An OPTIONAL paid upgrade layered on top of the account-activation gate
# above, not a replacement for it: member pricing on products that offer
# it, and access to categories flagged members-only. `gate` defaults to
# `off` - membership restricts nothing beyond those two perks. Set it to
# `purchase` (browsing open, membership required to buy) or `all` (full
# paywall on top of activation) only if you want membership itself to
# double as a further gate. See App\Lib\Router::membershipGateApplies()
# for exactly which routes each mode covers.
MEMBERSHIP_GATE=off
# One-time fee, in minor units. 50.00
MEMBERSHIP_FEE_MINOR=5000

#--- Primary nav (optional overrides) -----------------------------------
# Relabel nav items without a code change. Leave unset to use the
# defaults shown here. Hrefs are not configurable this way - see the
# 'nav' key in app/config.php.
NAV_LABEL_NEWS=News
NAV_LABEL_PREORDER=Preorder
NAV_LABEL_COLLECTIONS=Collections
NAV_LABEL_MEMBERSHIP=Membership
NAV_LABEL_SUPPORT=Support

#--- Payments: Coinbase Commerce (disabled) ----------------------------
# Not used while MANUAL_BTC_ADDRESS above is the live deposit path.
# Coinbase Commerce is not reachable from every country; if that ever
# changes for this store, filling these back in and re-adding the
# routes in index.php (see git history) brings the automatic-credit
# flow back. Leave blank otherwise.
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_URL=https://api.commerce.coinbase.com
DEPOSIT_ASSET=BTC
DEPOSIT_REQUIRED_CONFIRMATIONS=2
DEPOSIT_QUOTE_LOCK_SECONDS=3600
DEPOSIT_DISCLOSED_NETWORK_FEE_MINOR=0
DEPOSIT_FEE_BPS=0

#--- Mail --------------------------------------------------------------
# Hostinger SMTP. Create the mailbox in hPanel > Emails first.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=no-reply@example.com
MAIL_PASS=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Billions Store"

#--- Cron --------------------------------------------------------------
# Long random string. Hostinger's cron panel calls
#   https://your-domain/cron/run?token=THIS
# Generate with:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
CRON_TOKEN=

#--- Sessions / security ----------------------------------------------
# Absolute session lifetime in seconds regardless of activity (8h).
SESSION_ABSOLUTE_TIMEOUT=28800
# Idle timeout in seconds (2h).
SESSION_IDLE_TIMEOUT=7200
# Trusted proxy header for client IP. Leave empty unless you are behind
# a proxy you control - otherwise clients can spoof their IP and defeat
# the rate limiter.
TRUSTED_PROXY_IP_HEADER=

#--- Admin bootstrap ---------------------------------------------------
# Used once by bin/seed.php to create the first admin. Change the
# password immediately after first login, then blank these out.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
