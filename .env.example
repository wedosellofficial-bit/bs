#=======================================================================
# Billions Store - environment configuration
#
# Copy to `.env` in the SAME directory as `index.php` and `app/` - this
# whole tree deploys as one unit, see README.md's "Layout" section for
# why - then:  chmod 600 .env
#
# This file must never be web-reachable. What keeps it that way is the
# root .htaccess's dotfile-deny rule, not its filesystem location. If you
# can load https://your-domain/.env in a browser, that rule has been
# lost or overridden - check the root .htaccess before putting real
# keys in this file.
#=======================================================================

#--- Environment -------------------------------------------------------
# production | development
# development turns on error display and relaxes the HTTPS-only cookie
# flag so you can work on http://localhost.
APP_ENV=production
APP_NAME="Billions Store"
APP_URL=https://example.com

# 32+ random bytes, base64. Used to sign email-verification and
# password-reset tokens and to derive the TOTP secret encryption key.
# Generate with:  php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

#--- Database ----------------------------------------------------------
# Hostinger gives you these in hPanel > Databases > Management.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_billions
DB_USER=u000000000_billions
DB_PASS=
DB_CHARSET=utf8mb4

#--- Money -------------------------------------------------------------
# The ledger is denominated in this fiat currency, stored as signed
# integer minor units (cents). Crypto is converted at deposit time; we
# never store a fractional balance.
LEDGER_CURRENCY=USD
LEDGER_CURRENCY_MINOR_DIGITS=2

# Minimum and maximum single top-up, in minor units. 25.00 - 25,000.00
TOPUP_MIN_MINOR=2500
TOPUP_MAX_MINOR=2500000

#--- Chain: Bitcoin Ordinals ------------------------------------------
# Ordinals are inscriptions on satoshis; there is no contract address.
# Receiving wallets must be taproot (bc1p...) or the inscription can be
# lost as a network fee by a wallet that does not track ordinals.
CHAIN=bitcoin-ordinals
BITCOIN_NETWORK=mainnet
# Comma-separated bech32 human-readable parts accepted for buyer
# addresses. mainnet = bc ; testnet/signet = tb ; regtest = bcrt
BITCOIN_ADDRESS_HRP=bc
# Require taproot (witness v1 / bc1p) for buyer payout addresses.
# Strongly recommended: leave at true.
REQUIRE_TAPROOT_PAYOUT=true

# Block explorers. %s is substituted.
EXPLORER_TX_URL=https://mempool.space/tx/%s
EXPLORER_ADDRESS_URL=https://mempool.space/address/%s
EXPLORER_INSCRIPTION_URL=https://ordinals.com/inscription/%s

#--- Payments: Coinbase Commerce --------------------------------------
# Dashboard > Settings > API keys
COINBASE_COMMERCE_API_KEY=
# Dashboard > Settings > Webhook subscriptions > "Show shared secret".
# This is NOT the API key. The webhook handler verifies
# X-CC-Webhook-Signature = HMAC-SHA256(raw_body, this_secret).
COINBASE_COMMERCE_WEBHOOK_SECRET=
COINBASE_COMMERCE_API_URL=https://api.commerce.coinbase.com

# Which asset users top up with. This build is wired for BTC.
DEPOSIT_ASSET=BTC
# Confirmations required before a deposit is credited to the ledger.
# Coinbase Commerce resolves a charge at 1-2 confs for BTC; we display
# this number to the user and hold "pending" until the provider
# confirms.
DEPOSIT_REQUIRED_CONFIRMATIONS=2
# How long a quoted BTC amount / exchange rate is honoured, in seconds.
# Coinbase Commerce charges expire after 60 minutes by default.
DEPOSIT_QUOTE_LOCK_SECONDS=3600
# Network fee we disclose to the user before they send, in minor units.
# Purely informational - miners take it, not us.
DEPOSIT_DISCLOSED_NETWORK_FEE_MINOR=0
# Our processing fee in basis points, applied to the credited amount.
# 0 = we credit the full converted value.
DEPOSIT_FEE_BPS=0

#--- Mail --------------------------------------------------------------
# Hostinger SMTP. Create the mailbox in hPanel > Emails first.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USER=no-reply@example.com
MAIL_PASS=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Billions Store"

#--- Cron --------------------------------------------------------------
# Long random string. Hostinger's cron panel calls
#   https://your-domain/cron/run?token=THIS
# Generate with:  php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
CRON_TOKEN=

#--- Sessions / security ----------------------------------------------
# Absolute session lifetime in seconds regardless of activity (8h).
SESSION_ABSOLUTE_TIMEOUT=28800
# Idle timeout in seconds (2h).
SESSION_IDLE_TIMEOUT=7200
# Trusted proxy header for client IP. Leave empty unless you are behind
# a proxy you control - otherwise clients can spoof their IP and defeat
# the rate limiter.
TRUSTED_PROXY_IP_HEADER=

#--- Admin bootstrap ---------------------------------------------------
# Used once by bin/seed.php to create the first admin. Change the
# password immediately after first login, then blank these out.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
